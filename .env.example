# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's already in .gitignore.

# Safe to expose client-side (Supabase's newer "publishable" key format)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_757vU4WoOyLcRlq0wvWc4w_Nu9UbdVS

# --- Everything below this line is SECRET and must NEVER go in a .env file ---
# --- read by the frontend, or in this repo at all.                        ---
#
# These are set as Supabase Edge Function secrets instead, e.g.:
#   supabase secrets set DEEPSEEK_API_KEY=sk-...
#   supabase secrets set DEEPSEEK_API_KEY_FALLBACK=sk-...
#   supabase secrets set EMAIL_PROVIDER_API_KEY=...
#
# DEEPSEEK_API_KEY            (server-side only, via `supabase secrets set`)
# DEEPSEEK_API_KEY_FALLBACK   (server-side only, via `supabase secrets set`)
# EMAIL_PROVIDER_API_KEY      (server-side only, via `supabase secrets set`)
# SUPABASE_SERVICE_ROLE_KEY   (server-side only, via `supabase secrets set` — needed by Edge Functions to write drafts)
